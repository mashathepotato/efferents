# Challengescape lab NN — <short name>.
# Challenge framing: "<exact challenge title>" (Encode Challengescape, <domain>).

goal: >
  <one falsifiable sentence: maximize/minimize <metric> by tuning <knob>,
  under <constraint>>

train_command: "python3 train.py --config {config_path}"
eval_command: "python3 eval.py --checkpoint {checkpoint}"
config_template: configs/base.yaml

sweep:
  param: <knob>
  values: [<≤10 values; include at least one expected-failure regime>]

metric: "<headline_metric>"
maximize: true

budget:
  max_gpu_hours: 0.2
  max_llm_cost_usd: 0

approval:
  mode: "plan_then_execute"

outputs:
  journal_dir: "journal"
  runs_file: "runs.jsonl"
  claims_file: "claims.jsonl"
